# ══════════════════════════════════════════════════════════════════════
# SPOT 24 · Variables de entorno — NUEVO en Ronda 3
# ══════════════════════════════════════════════════════════════════════
# COPIA este archivo como .env y rellena los valores:
#   Windows PowerShell:  Copy-Item .env.example .env
#
# · El .env NUNCA se sube a GitHub (está en .gitignore).
# · `npx netlify-cli dev` lee ESTE archivo para TODO (Vite y funciones).
#   NO lee las variables del panel de Netlify: en local, todo va por aquí.
# · En producción (app.netlify.com → Site configuration → Environment
#   variables) deben existir LAS MISMAS claves con LOS MISMOS valores.

# ── Frontend · Firebase (públicas por diseño; se compilan en la PWA) ──
# Firebase Console → ⚙️ Configuración del proyecto → Tus apps → SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Frontend · Notificaciones push (opcional) ──
# Firebase Console → ⚙️ Configuración → Cloud Messaging → Claves Web Push
VITE_FCM_VAPID_KEY=

# ── Frontend · App Check (fase 1, opcional: monitoreo) ──
# Firebase Console → App Check → Apps → Web → reCAPTCHA v3
#VITE_RECAPTCHA_V3_SITE_KEY=
# Desarrollo local con enforce activado: registra el token debug primero.
#VITE_APPCHECK_DEBUG_TOKEN=

# ── Frontend · Analítica (opcional) ──
VITE_ANALYTICS_ENABLED=false

# ── Servidor · Credencial Admin SDK (OBLIGATORIA) ──
# JSON COMPLETO de la clave privada de la cuenta de servicio, o el mismo
# JSON codificado en base64. Ver LEEME-RONDA-3.md § 3.
FIREBASE_SERVICE_ACCOUNT=

# ── Servidor · Clave de cifrado AES-256-GCM (NUEVA · OBLIGATORIA) ──
# 64 caracteres hexadecimales = 32 bytes. Genera UNA vez y usa el MISMO
# valor aquí y en Netlify:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta variable, las funciones FALLAN en producción (fail closed).
ENC_KEY_HEX=

# ── Servidor · imgbb (fotos de catálogo y comprobantes) ──
IMGBB_API_KEY=

# ── Servidor · Disparo manual de la tasa BCV ──
# http://localhost:8888/.netlify/functions/fn-runBcvRate?key=ESTA_CLAVE
BCV_RUN_KEY=

# ── Servidor · Bootstrap del primer admin (ELIMINAR tras usarlo) ──
ADMIN_SETUP_KEY=

# ── Servidor · App Check en modo exigente (SOLO tras fase de monitoreo) ──
#APPCHECK_ENFORCE=true
