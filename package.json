{
  "name": "spot24-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPOT 24 — PWA de e-commerce. Tu parada segura. 24/7.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 3000 --host",
    "typecheck": "tsc --noEmit",
    "typecheck:netlify": "tsc -p netlify/functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --exclude 'src/tests/rules/**'",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run src/tests/rules'",
    "test:rules:only": "vitest run src/tests/rules",
    "deploy:firebase": "firebase deploy --only functions,firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "notistack": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/functions": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}